<Window x:Class="PdfRead.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings &amp; Windows Integration - PdfRead"
        Height="620" Width="680"
        MinHeight="500" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="#09090B"
        Foreground="#F4F4F5"
        FontFamily="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif">

    <Window.Resources>
        <!-- Primary Action Button (Red Accent) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#D32F2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#27272A"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EF5350"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#7F1D1D"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#991B1B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content Cards -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="6" Background="#C62828" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="PDF" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PdfRead Settings &amp; Shell Integration" FontWeight="Bold" FontSize="16" Foreground="#FAFAFA"/>
                    <TextBlock Text="Update desktop and taskbar shortcuts, startup options, and Windows Explorer context menus" Foreground="#71717A" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Scrollable Options Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <!-- Status Feedback Banner -->
                <Border x:Name="StatusBanner" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock x:Name="TxtStatusBanner" Text="Action completed." Foreground="#34D399" FontSize="12" FontWeight="Medium"/>
                </Border>

                <!-- SECTION 1: Desktop, Taskbar & Startup Icons (User requested) -->
                <TextBlock Text="Desktop, Taskbar &amp; Startup Shortcuts" Foreground="#FAFAFA" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <!-- Desktop Shortcut Card -->
                <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Desktop Shortcut" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Creates or updates the PdfRead shortcut on your Windows Desktop with the red PDF badge icon." 
                                       Foreground="#71717A" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Update Desktop Icon" Style="{StaticResource SecondaryButtonStyle}" 
                                Click="BtnUpdateDesktopShortcut_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Start Menu & Taskbar Card -->
                <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Start Menu &amp; Taskbar Shortcut" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Places the shortcut in your Start Menu Programs folder so you can search for PdfRead or pin it to your Windows Taskbar." 
                                       Foreground="#71717A" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Update Start Menu / Taskbar" Style="{StaticResource SecondaryButtonStyle}" 
                                Click="BtnUpdateStartMenuShortcut_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Startup Card -->
                <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Launch on Windows Startup" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="TxtStartupStatus" Text="" Foreground="#34D399" FontSize="11" FontWeight="Medium" Margin="8,1,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Automatically starts the single-instance background pipe listener so opening PDFs is instantaneous." 
                                       Foreground="#71717A" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnToggleStartup" Grid.Column="1" Content="Toggle Startup" Style="{StaticResource SecondaryButtonStyle}" 
                                Click="BtnToggleStartup_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 1-Click Update All Shortcuts Button -->
                <Button Content="⚡ 1-Click Update All Shortcuts &amp; Icons (Desktop, Taskbar, Start Menu)" 
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,20" Click="BtnUpdateAllShortcuts_Click"/>

                <!-- SECTION 2: Windows Explorer Context Menus -->
                <TextBlock Text="Windows Explorer Right-Click Menus" Foreground="#FAFAFA" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <!-- File Context Menu Card -->
                <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&quot;Open with PdfRead&quot; on PDF files" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="TxtPdfMenuStatus" Text="" Foreground="#34D399" FontSize="11" FontWeight="Medium" Margin="8,1,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Right-click any .pdf file to open it in a tab in PdfRead." 
                                       Foreground="#71717A" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnTogglePdfMenu" Grid.Column="1" Content="Toggle" Style="{StaticResource SecondaryButtonStyle}" 
                                Click="BtnTogglePdfMenu_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Office Conversion Context Menu Card -->
                <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&quot;Convert to PDF with PdfRead&quot; (Word &amp; Excel)" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="TxtOfficeMenuStatus" Text="" Foreground="#34D399" FontSize="11" FontWeight="Medium" Margin="8,1,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Right-click any .docx, .xlsx, or .pptx file in Explorer to convert headlessly to PDF." 
                                       Foreground="#71717A" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnToggleOfficeMenu" Grid.Column="1" Content="Toggle" Style="{StaticResource SecondaryButtonStyle}" 
                                Click="BtnToggleOfficeMenu_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Windows 11 Primary Menu Card -->
                <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Windows 11: Show directly on first right-click" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="TxtWin11Status" Text="" Foreground="#34D399" FontSize="11" FontWeight="Medium" Margin="8,1,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Displays PdfRead context menus on the primary right-click menu without clicking 'Show more options'." 
                                       Foreground="#71717A" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnToggleWin11" Grid.Column="1" Content="Toggle" Style="{StaticResource SecondaryButtonStyle}" 
                                Click="BtnToggleWin11_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- SECTION 3: System Associations & Clean-Up -->
                <TextBlock Text="Default Viewer &amp; Clean-Up" Foreground="#FAFAFA" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Set as Default PDF Application" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Opens the Windows system picker to make PdfRead your default viewer for all PDF files." 
                                       Foreground="#71717A" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Set as Default" Style="{StaticResource SecondaryButtonStyle}" 
                                Click="BtnSetDefault_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Clean Remove All -->
                <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Remove All Registry Menus &amp; Associations" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Cleanly deletes all context menu entries and HKCU registry keys created by PdfRead." 
                                       Foreground="#71717A" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Remove All" Style="{StaticResource DangerButtonStyle}" 
                                Click="BtnRemoveAll_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="20,12">
            <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Width="80" Click="BtnClose_Click"/>
        </Border>
    </Grid>
</Window>
